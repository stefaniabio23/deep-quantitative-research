# Copy to .env and fill in the values you need.
# Secrets must never be committed.

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Path to the sibling datasources repo. Override only if not at the default location.
DATASOURCES_PATH=../datasources

# Cache directory for fetched data. Defaults to ~/.cache/deep-quantitative-research/.
# DEEP_QUANT_CACHE_DIR=
